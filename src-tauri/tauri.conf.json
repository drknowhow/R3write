{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R3write",
  "version": "1.4.2",
  "identifier": "com.r3write.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "R3write",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 320,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "quick-edit",
        "title": "R3write quick edit",
        "url": "quick-edit.html",
        "width": 780,
        "height": 560,
        "minWidth": 480,
        "minHeight": 380,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "autocorrect-bubble",
        "title": "R3write autocorrect",
        "url": "autocorrect-bubble.html",
        "width": 340,
        "height": 76,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi"
      }
    }
  }
}

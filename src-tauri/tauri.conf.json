{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R3write",
  "version": "1.0.0",
  "identifier": "com.r3write.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "R3write",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 320,
        "center": true,
        "resizable": true
      },
      {
        "label": "quick-edit",
        "title": "R3write quick edit",
        "width": 780,
        "height": 560,
        "minWidth": 480,
        "minHeight": 380,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
